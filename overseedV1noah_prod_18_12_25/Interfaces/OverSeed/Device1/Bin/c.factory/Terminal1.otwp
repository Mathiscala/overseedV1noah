          <KeyBinding Key="UP" BindOn="Move_UP" />
        </KeyBindings>
      </Mask>
      <Mask Name="SysInfo_2" Type="Normal" X="2" Y="8" Color="LightCyan">
        <Fields>
          <Field Type="Image" Name="Image_1" Row="0" Column="0" Content="BLACK_ROWS_132X8.BMP" />
          <Field Type="Text" Name="Text_1" Row="0" Column="1" Content="45" />
          <Field Type="Variable" Name="Variable_2" Row="4" Column="0" Content="GeneralMng.PrgCycleMs" Class="CL_UINT" Format="o4" Min="0" Max="9999" />
          <Field Type="Text" Name="Text_3" Row="4" Column="15" Content="46" />
          <Field Type="Text" Name="Text_4" Row="4" Column="4" Content="47" />
          <Field Type="Variable" Name="Variable_1" Row="4" Column="7" Content="GeneralMng.CyclesPerSecond" Class="CL_REAL_2" Format="o+5.1" Min="-99999.9" Max="99999.9" />
