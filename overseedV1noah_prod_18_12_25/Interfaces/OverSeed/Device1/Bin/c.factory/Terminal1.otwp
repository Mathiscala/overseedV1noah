<?xml version="1.0" encoding="utf-8"?>
<Terminal Name="Terminal1" Display="PGD1" Language="EN" BeginFromMask="CarelLogo" Layout="SixKeys" Font="CAREL_TERM_INT" ZoomCode="0" LoopFunction="TIMED_LOOP" Version="1.0">
  <ShortCuts>
    <ShortCut Name="ALARM" Code="12" />
    <ShortCut Name="PRG" Code="5" />
    <ShortCut Name="UP" Code="14" />
    <ShortCut Name="ENTER" Code="13" />
    <ShortCut Name="DOWN" Code="15" />
    <ShortCut Name="ESC" Code="0" />
    <ShortCut Name="PRG+ENTER" Keys="PRG,ENTER" Code="88" />
    <ShortCut Name="ESC+DOWN" Keys="ESC,DOWN" Code="30" />
  </ShortCuts>
  <KeyBindings>
    <KeyBinding Key="ALARM" BindOn="CheckActiveAlarm" />
    <KeyBinding Key="ESC" BindOn="GlobalEsc" />
    <KeyBinding Key="PRG" BindOn="GotoMainMenu" />
    <KeyBinding Key="PRG+ENTER" BindOn="Terminal_KeyPRG_ENT" />
    <KeyBinding Key="ESC+DOWN" BindOn="Terminal_KeyESC_DOWN" />
  </KeyBindings>
  <Worksheet Name="01_Alrms" Version="1.0.0">
    <Loop Name="ACTIVEALARMS" Type="Normal" X="0" Y="2">
      <Mask Name="Alrms_Active" Type="Normal" X="0" Y="3" Color="Red">
        <Fields>
          <Field Name="ImageField_1" Type="Image" Row="0" Column="0" Content="BLACK_ROWS_132X8.BMP" />
          <Field Name="Field_1" Type="Text" Row="0" Column="0" Content="0" />
          <Field Name="AlrmIdx_1" Type="Variable" Row="0" Column="17" Content="AlrmIdx" Class="CL_DINT" Format="o2z" Min="0" Max="99" />
          <Field Name="TotAlrm_1" Type="Variable" Row="0" Column="20" Content="N_Alrms" Class="CL_DINT" Format="o2z" Min="0" Max="99" />
          <Field Name="AlrmCode_1" Type="Variable" Row="1" Column="0" Content="AlrmCode" Class="AlrmNo" Format="o1" Min="0" Max="9" />
          <Field Name="AlrmCode_2" Type="Variable" Row="3" Column="0" Content="AlrmCode" Class="AlrmDescr" Format="o1" Min="0" Max="9" />
          <Field Name="ALrmDay_1" Type="Variable" Row="1" Column="14" Content="AlarmMng.AlrmDay" Class="EnDateDDMMYY" Format="o2z" Min="0" Max="99" />
          <Field Name="AlrmMonth_1" Type="Variable" Row="1" Column="17" Content="AlarmMng.AlrmMonth" Class="EnDateDDMMYY" Format="o2z" Min="0" Max="99" />
          <Field Name="AlrmYear_1" Type="Variable" Row="1" Column="20" Content="AlarmMng.AlrmYear" Class="EnDateDDMMYY" Format="o2z" Min="0" Max="99" />
          <Field Name="AlrmHour_1" Type="Variable" Row="1" Column="8" Content="AlarmMng.AlrmHour" Class="CL_UINT" Format="o2z" Min="0" Max="99" />
          <Field Name="AlrmMin_1" Type="Variable" Row="1" Column="11" Content="AlarmMng.AlrmMinute" Class="CL_UINT" Format="o2z" Min="0" Max="99" />
          <Field Name="Field_4" Type="Text" Row="1" Column="10" Content="1" />
          <Field Name="AlrmStoredVarReal1_1" Type="Variable" Row="6" Column="15" Content="AlrmStoredVarReal1" Class="Var1_Real" Format="o+3.2" Min="-999.99" Max="999.99" />
          <Field Name="AlrmStoredVarReal2_1" Type="Variable" Row="7" Column="15" Content="AlrmStoredVarReal2" Class="Var2_Real" Format="o+3.2" Min="-999.99" Max="999.99" />
          <Field Name="Variable_1" Type="Variable" Row="6" Column="0" Content="AlrmCode" Class="NameVar1" Format="o1" Min="0" Max="9" />
          <Field Name="Variable_2" Type="Variable" Row="7" Column="0" Content="AlrmCode" Class="NameVar2" Format="o1" Min="0" Max="9" />
          <Field Type="Variable" Name="Variable" Row="1" Column="14" Content="AlarmMng.AlrmMonth" Min="0" Max="99" Class="EnDateMMDDYY" Format="o2z" />
          <Field Type="Variable" Name="Variable_3" Row="1" Column="14" Content="AlarmMng.AlrmYear" Min="0" Max="99" Class="EnDateYYMMDD" Format="o2z" />
          <Field Type="Variable" Name="Variable_4" Row="1" Column="17" Content="AlarmMng.AlrmDay" Min="0" Max="99" Class="EnDateMMDDYY" Format="o2z" />
          <Field Type="Variable" Name="Variable_5" Row="1" Column="17" Content="AlarmMng.AlrmMonth" Min="0" Max="99" Class="EnDateYYMMDD" Format="o2z" />
          <Field Type="Variable" Name="Variable_6" Row="1" Column="20" Content="AlarmMng.AlrmYear" Min="0" Max="99" Class="EnDateMMDDYY" Format="o2z" />
          <Field Type="Variable" Name="Variable_7" Row="1" Column="20" Content="AlarmMng.AlrmDay" Min="0" Max="99" Class="EnDateYYMMDD" Format="o2z" />
        </Fields>
        <KeyBindings>
          <KeyBinding Key="ALARM" BindOn="ResetSingleAlarm" />
          <KeyBinding Key="UP" BindOn="ScrollAlarm_UP" />
          <KeyBinding Key="DOWN" BindOn="ScrollAlarm_DOWN" />
        </KeyBindings>
        <EnableOn />
        <ResourceUsedOnInt />
        <ResourceUsedOnBool />
      </Mask>
      <Mask Name="Alrms_Res" Type="Normal" X="0" Y="4" ReferToMask="" Color="Red">
        <Fields>
          <Field Name="BLACK_ROWS_132X8_BMP_1" Type="Image" Row="0" Column="0" Content="BLACK_ROWS_132X8.BMP" />
          <Field Name="Field_3" Type="Text" Row="0" Column="0" Content="2" />
          <Field Name="to_DATA_LOGGER_2" Type="Text" Row="7" Column="3" Content="3" />
          <Field Name="Press_ENTER_2" Type="Text" Row="6" Column="3" Content="4" />
          <Field Name="Field_1" Type="Text" Row="2" Column="3" Content="5" />
          <Field Name="Field_2" Type="Text" Row="3" Column="3" Content="6" />
          <Field Name="ImageField_1" Type="Image" Row="2" Column="0" Content="alarm_pGD.bmp" />
          <Field Type="Image" Name="Image_1" Row="6" Column="0" Content="History.bmp" />
          <Field Type="Text" Name="Text_1" Row="4" Column="3" Content="7" />
        </Fields>
        <KeyBindings>
          <KeyBinding Key="ENTER" BindOn="gotoAlarmLog" />
          <KeyBinding Key="UP" BindOn="ScrollAlarm_UP" />
          <KeyBinding Key="DOWN" BindOn="ScrollAlarm_DOWN" />
          <KeyBinding Key="ALARM" BindOn="ResetGlobalAlarm" />
        </KeyBindings>
        <EnableOn />
        <ResourceUsedOnInt />
        <ResourceUsedOnBool />
      </Mask>
    </Loop>
    <Loop Name="ALRMLOGS" Type="Normal" X="1" Y="2">
      <Mask Name="Alrms_Log" Type="Normal" X="1" Y="3" Color="255, 128, 128">
        <Fields>
          <Field Name="ImageField_1" Type="Image" Row="0" Column="0" Content="BLACK_ROWS_132X8.BMP" />
          <Field Name="AlrmIdx_1" Type="Variable" Row="0" Column="19" Content="AlrmLogsIdx" Class="CL_DINT" Format="o3z" Min="0" Max="999" />
          <Field Name="AlrmCode_1" Type="Variable" Row="1" Column="0" Content="AlrmLogCode" Class="AlrmNo" Format="o1" Min="0" Max="9" />
          <Field Name="AlrmCode_2" Type="Variable" Row="3" Column="0" Content="AlrmLogCode" Class="AlrmDescr" Format="o1" Min="0" Max="9" />
          <Field Name="ALrmDay_1" Type="Variable" Row="1" Column="14" Content="AlarmMng.AlrmLogDay" Class="CL_UINT" Format="o2z" Min="0" Max="99" />
          <Field Name="AlrmMonth_1" Type="Variable" Row="1" Column="17" Content="AlarmMng.AlrmLogMonth" Class="CL_UINT" Format="o2z" Min="0" Max="99" />
          <Field Name="AlrmYear_1" Type="Variable" Row="1" Column="20" Content="AlarmMng.AlrmLogYear" Class="CL_UINT" Format="o2z" Min="0" Max="99" />
          <Field Name="AlrmHour_1" Type="Variable" Row="1" Column="8" Content="AlarmMng.AlrmLogHour" Class="CL_UINT" Format="o2z" Min="0" Max="99" />
          <Field Name="AlrmMin_1" Type="Variable" Row="1" Column="11" Content="AlarmMng.AlrmLogMinute" Class="CL_UINT" Format="o2z" Min="0" Max="99" />
          <Field Name="Field_5" Type="Text" Row="0" Column="0" Content="8" />
          <Field Name="Data_logger_1" Type="Text" Row="0" Column="10" Content="9" />
          <Field Name="Field_1" Type="Text" Row="5" Column="0" Content="10" />
          <Field Type="Variable" Name="Variable_3" Row="5" Column="13" Content="AlrmLogEventType" Class="AlrmLogEvent" Format="o1" Min="0" Max="9" />
          <Field Type="Text" Name="Text_1" Row="1" Column="9" Content="11" />
          <Field Name="Variable_2" Type="Variable" Row="6" Column="0" Content="AlrmCode" Class="NameVar1" Format="o1" Min="0" Max="9" />
          <Field Name="Variable_4" Type="Variable" Row="7" Column="0" Content="AlrmCode" Class="NameVar2" Format="o1" Min="0" Max="9" />
          <Field Name="Variable_5" Type="Variable" Row="6" Column="15" Content="AlrmStoredVarReal1" Class="Var1_Real" Format="o+3.2" Min="-999.99" Max="999.99" />
          <Field Name="Variable_6" Type="Variable" Row="7" Column="15" Content="AlrmStoredVarReal2" Class="Var2_Real" Format="o+3.2" Min="-999.99" Max="999.99" />
        </Fields>
        <KeyBindings>
          <KeyBinding Key="UP" BindOn="ScrollAlarmLog_UP" />
          <KeyBinding Key="DOWN" BindOn="ScrollAlarmLog_DOWN" />
        </KeyBindings>
        <EnableOn />
        <ResourceUsedOnInt />
        <ResourceUsedOnBool />
      </Mask>
    </Loop>
    <Mask Name="Alrms_NoLog" Type="Normal" X="1" Y="1" ZoomCode="17">
      <Fields>
        <Field Name="NO_ACTIVE_ALAMRS_1" Type="Text" Row="2" Column="0" Content="12" />
        <Field Name="BLACK_ROWS_132X8_BMP_1" Type="Image" Row="0" Column="0" Content="BLACK_ROWS_132X8.BMP" />
        <Field Name="Field_1" Type="Text" Row="0" Column="0" Content="13" />
        <Field Type="Text" Name="Text_1" Row="3" Column="0" Content="14" />
      </Fields>
      <KeyBindings />
      <EnableOn />
      <ResourceUsedOnInt />
      <ResourceUsedOnBool />
    </Mask>
    <Mask Name="Alrms_NoAlrms" Type="Normal" X="0" Y="1" ZoomCode="3" ReferToMask="">
      <Fields>
        <Field Name="ImageField_1" Type="Image" Row="0" Column="0" Content="BLACK_ROWS_132X8.BMP" />
        <Field Name="Field_1" Type="Text" Row="2" Column="0" Content="15" />
        <Field Name="to_DATA_LOGGER_1" Type="Text" Row="6" Column="3" Content="16" />
        <Field Name="Press_ENTER_1" Type="Text" Row="5" Column="3" Content="17" />
        <Field Type="Image" Name="Image_1" Row="6" Column="0" Content="History.bmp" />
      </Fields>
      <KeyBindings>
        <KeyBinding Key="ENTER" BindOn="gotoAlarmLog" />
      </KeyBindings>
      <EnableOn />
      <ResourceUsedOnInt />
      <ResourceUsedOnBool />
    </Mask>
  </Worksheet>
  <Worksheet Name="02_Main" Version="1.0.0">
    <Mask Name="Main" Type="Normal" X="0" Y="4">
      <Fields>
        <Field Type="Image" Name="Image_1" Row="0" Column="0" Content="BLACK_ROWS_132X8.BMP" />
        <Field Type="Text" Name="Text_1" Row="3" Column="0" Content="82" />
        <Field Type="Text" Name="Text_2" Row="0" Column="2" Content="83" />
        <Field Type="Text" Name="Text_3" Row="0" Column="5" Content="84" />
        <Field Type="Text" Name="Text_4" Row="0" Column="19" Content="85" />
        <Field Type="Variable" Name="Variable_1" Row="0" Column="0" Content="Date1" Class="CL_UINT" Format="o2z" Min="0" Max="99" />
        <Field Type="Variable" Name="Variable_2" Row="0" Column="3" Content="Date2" Class="CL_UINT" Format="o2z" Min="0" Max="99" />
        <Field Type="Variable" Name="Variable_3" Row="0" Column="6" Content="Date3" Class="CL_UINT" Format="o2z" Min="0" Max="99" />
        <Field Type="Variable" Name="Variable_4" Row="0" Column="20" Content="GeneralMng.Minute" Class="CL_UINT" Format="o2z" Min="0" Max="99" />
        <Field Type="Variable" Name="Variable_5" Row="0" Column="17" Content="GeneralMng.Hour" Class="CL_UINT" Format="o2z" Min="0" Max="99" />
        <Field Type="Image" Name="Image_2" Row="6" Column="16" Content="Black_.bmp" />
        <Field Type="Variable" Name="Variable_7" Row="6" Column="17" Content="IdxImgQM" Class="IdxImgQM" Format="o1" Min="0" Max="9" />
        <Field Type="Image" Name="Image_4" Row="6" Column="20" Content="UpDown2.bmp" />
        <Field Type="Text" Name="Text_5" Row="6" Column="0" Content="86" />
        <Field Type="Variable" Name="Variable_6" Row="7" Column="0" Content="UnitStatus" Class="UnitStatus" Format="o1" Min="0" Max="9" />
        <Field Type="Variable" Name="Variable_8" Row="0" Column="11" Content="GeneralMng.DayOfWeek" Class="DayOfWeekShort" Format="o1" Min="0" Max="9" />
      </Fields>
      <KeyBindings>
        <KeyBinding Key="PRG" BindOn="GotoMainMenu" />
        <KeyBinding Key="UP" BindOn="QuickMenuUP" />
        <KeyBinding Key="DOWN" BindOn="QuickMenuDOWN" />
        <KeyBinding Key="ENTER" BindOn="QuickMenuENT" />
      </KeyBindings>
    </Mask>
    <Loop Name="STARTUP" Type="Normal" X="0" Y="0">
      <Mask Name="CarelLogo" Type="Normal" X="0" Y="1">
        <Fields>
          <Field Type="Image" Name="Image_1" Row="1" Column="0" Content="logo_carel_132x64.bmp" />
        </Fields>
        <KeyBindings>
          <KeyBinding Key="ALARM" BindOn="DoNothing" />
          <KeyBinding Key="ESC" BindOn="DoNothing" />
          <KeyBinding Key="PRG" BindOn="DoNothing" />
        </KeyBindings>
      </Mask>
      <Mask Name="Language" Type="Normal" X="0" Y="2">
        <Fields>
          <Field Type="Image" Name="Image_1" Row="0" Column="0" Content="BLACK_ROWS_132X8.BMP" />
          <Field Type="Image" Name="Image_2" Row="7" Column="0" Content="BLACK_ROWS_132X8.BMP" />
          <Field Type="Variable" Name="Variable_7" Row="7" Column="20" Content="LangTime" Class="CL_INT" Format="o2" Min="0" Max="99" />
          <Field Type="Text" Name="Text_1" Row="0" Column="0" Content="18" />
          <Field Type="Text" Name="Text_2" Row="2" Column="0" Content="19" />
          <Field Type="Text" Name="Text_3" Row="2" Column="12" Content="20" />
          <Field Type="Text" Name="Text_4" Row="4" Column="0" Content="21" />
          <Field Type="Text" Name="Text_5" Row="5" Column="0" Content="22" />
          <Field Type="Text" Name="Text_6" Row="7" Column="0" Content="23" />
        </Fields>
        <KeyBindings>
          <KeyBinding Key="ENTER" BindOn="Lang_UP" />
          <KeyBinding Key="ESC" BindOn="GotoMain" />
        </KeyBindings>
      </Mask>
    </Loop>
    <Loop Name="ONOFF" Type="Normal" X="0" Y="5">
      <Mask Name="OnOff" Type="Normal" X="0" Y="6" Color="ActiveCaption">
        <Fields>
          <Field Type="Image" Name="Image_1" Row="0" Column="0" Content="BLACK_ROWS_132X8.BMP" />
          <Field Type="Variable" Name="Variable_6" Row="2" Column="0" Content="OnOffUnitMng.KeybOnOff" Class="KeybOnOff" Format="ob" Min="0" Max="1" />
          <Field Type="Text" Name="Text_1" Row="0" Column="0" Content="24" />
        </Fields>
        <KeyBindings>
          <KeyBinding Key="DOWN" BindOn="OnOffSwitch" />
          <KeyBinding Key="UP" BindOn="OnOffSwitch" />
        </KeyBindings>
      </Mask>
    </Loop>
    <Loop Name="SET" Type="Normal" X="1" Y="5">
      <Mask Name="Set" Type="Normal" X="1" Y="6" Color="LightBlue">
        <Fields>
          <Field Type="Image" Name="Image_1" Row="0" Column="0" Content="BLACK_ROWS_132X8.BMP" />
          <Field Type="Text" Name="Text_1" Row="0" Column="1" Content="25" />
          <Field Type="Variable" Name="Variable_1" Row="0" Column="0" Content="dummy" Class="CL_Move" Format="ib" Min="0" Max="1" />
          <Field Type="Variable" Name="Variable" Row="3" Column="8" Content="Fonctions.LeverDuSoleilH_1" Class="CL_INT" Format="io2" Min="0" Max="99" />
          <Field Type="Variable" Name="Variable_2" Row="7" Column="8" Content="Fonctions.CoucherDuSoleilH_1" Class="CL_INT" Format="io2" Min="0" Max="99" />
          <Field Type="Text" Name="Text" Row="5" Column="3" Content="26" />
          <Field Type="Variable" Name="Variable_3" Row="7" Column="11" Content="Fonctions.CoucherDuSoleilM_1" Class="CL_INT" Format="io2" Min="0" Max="99" />
          <Field Type="Text" Name="Text_2" Row="7" Column="10" Content="27" />
          <Field Type="Text" Name="Text_3" Row="1" Column="5" Content="28" />
          <Field Type="Variable" Name="Variable_4" Row="3" Column="11" Content="Fonctions.LeverDuSoleilM_1" Class="CL_INT" Format="io2" Min="0" Max="99" />
          <Field Type="Text" Name="Text_4" Row="3" Column="10" Content="29" />
        </Fields>
        <KeyBindings />
      </Mask>
    </Loop>
    <Loop Name="INFO" Type="Normal" X="2" Y="5">
      <Mask Name="SwInfo" Type="Normal" X="2" Y="6" Color="LightCyan">
        <Fields>
          <Field Type="Image" Name="Image_1" Row="0" Column="0" Content="BLACK_ROWS_132X8.BMP" />
          <Field Type="Text" Name="Text_3" Row="0" Column="1" Content="30" />
          <Field Type="Text" Name="Text_2" Row="5" Column="0" Content="31" />
          <Field Type="Text" Name="Text_5" Row="6" Column="0" Content="32" />
          <Field Type="Variable" Name="Variable_1" Row="6" Column="11" Content="GeneralMng.OsVersion[1]" Class="CL_UDINT" Format="o1" Min="0" Max="9" />
          <Field Type="Variable" Name="Variable_2" Row="6" Column="13" Content="GeneralMng.OsVersion[2]" Class="CL_UDINT" Format="o1" Min="0" Max="9" />
          <Field Type="Variable" Name="Variable_3" Row="6" Column="15" Content="GeneralMng.OsVersion[3]" Class="CL_UDINT" Format="o3z" Min="0" Max="999" />
          <Field Type="Text" Name="Text_7" Row="6" Column="12" Content="33" />
          <Field Type="Text" Name="Text_8" Row="6" Column="14" Content="34" />
          <Field Type="Text" Name="Text_4" Row="3" Column="0" Content="35" />
          <Field Type="Variable" Name="Variable_12" Row="0" Column="0" Content="dummy" Class="CL_Move" Format="ib" Min="0" Max="1" />
          <Field Type="Text" Name="Text" Row="7" Column="0" Content="36" />
          <Field Type="Variable" Name="Variable_4" Row="7" Column="11" Content="GeneralMng.BootVersion[1]" Class="CL_UDINT" Format="o1" Min="0" Max="9" />
          <Field Type="Variable" Name="Variable_5" Row="7" Column="13" Content="GeneralMng.BootVersion[2]" Class="CL_UDINT" Format="o1" Min="0" Max="9" />
          <Field Type="Variable" Name="Variable_6" Row="7" Column="15" Content="GeneralMng.BootVersion[3]" Class="CL_UDINT" Format="o3z" Min="0" Max="999" />
          <Field Type="Text" Name="Text_6" Row="7" Column="12" Content="37" />
          <Field Type="Text" Name="Text_9" Row="7" Column="14" Content="38" />
          <Field Type="Variable" Name="Variable" Row="5" Column="11" Content="GeneralMng.PROJECT_RELEASE_1" Class="CL_STRING" Format="o1" Min="0" Max="9" />
          <Field Type="Variable" Name="Variable_7" Row="3" Column="6" Content="GeneralMng.PROJECT_NAME_1" Class="CL_STRING" Format="o1" Min="0" Max="9" />
          <Field Type="Text" Name="Text_10" Row="1" Column="0" Content="39" />
        </Fields>
        <KeyBindings />
      </Mask>
      <Mask Name="SysInfo_1" Type="Normal" X="2" Y="7" Color="LightCyan">
        <Fields>
          <Field Type="Image" Name="Image_1" Row="0" Column="0" Content="BLACK_ROWS_132X8.BMP" />
          <Field Type="Text" Name="Text_1" Row="0" Column="1" Content="40" />
          <Field Type="Text" Name="Text_2" Row="2" Column="0" Content="41" />
          <Field Type="Text" Name="Text_5" Row="3" Column="0" Content="42" />
          <Field Type="Variable" Name="Variable_3" Row="2" Column="12" Content="GeneralMng.BoardTyp[1]" Class="pCO_Type" Format="o2" Min="0" Max="99" />
          <Field Type="Variable" Name="Variable_4" Row="3" Column="12" Content="GeneralMng.BoardTyp[2]" Class="BoardType" Format="o2" Min="0" Max="99" />
          <Field Type="Variable" Name="Variable_5" Row="5" Column="15" Content="BoardTempMsk" Class="BoardTempCPCO" Format="o+3.1" Min="0.0" Max="999.9" />
          <Field Type="Variable" Name="Variable_7" Row="0" Column="0" Content="dummy" Class="CL_Move" Format="ib" Min="0" Max="1" />
          <Field Type="Text" Name="Text_3" Row="4" Column="0" Content="43" />
          <Field Type="Variable" Name="Variable" Row="4" Column="20" Content="GeneralMng.Core" Class="CL_UINT" Format="o2" Min="0" Max="99" />
          <Field Type="Variable" Name="Variable_2" Row="5" Column="21" Content="STD_UOM_ZONE_UI" Min="0" Max="6" Class="Board_Temperature_C_UoM" Format="o1" />
          <Field Type="Variable" Name="Variable_9" Row="7" Column="14" Content="UID_1" Class="HexConv" Format="o2" Min="0" Max="99" />
          <Field Type="Variable" Name="Variable_10" Row="7" Column="16" Content="UID_2" Class="HexConv" Format="o2" Min="0" Max="99" />
          <Field Type="Variable" Name="Variable_11" Row="7" Column="18" Content="UID_3" Class="HexConv" Format="o2" Min="0" Max="99" />
          <Field Type="Variable" Name="Variable_12" Row="7" Column="20" Content="UID_4" Class="HexConv" Format="o2" Min="0" Max="99" />
          <Field Type="Variable" Name="Variable_13" Row="7" Column="12" Content="UID_8" Class="HexConv" Format="o2" Min="0" Max="99" />
          <Field Type="Variable" Name="Variable_14" Row="7" Column="10" Content="UID_7" Class="HexConv" Format="o2" Min="0" Max="99" />
          <Field Type="Variable" Name="Variable_15" Row="7" Column="8" Content="UID_6" Class="HexConv" Format="o2" Min="0" Max="99" />
          <Field Type="Variable" Name="Variable_16" Row="7" Column="6" Content="UID_5" Class="HexConv" Format="o2" Min="0" Max="99" />
          <Field Type="Text" Name="Text" Row="7" Column="0" Content="44" />
        </Fields>
        <KeyBindings>
